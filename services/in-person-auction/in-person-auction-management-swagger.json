                        },
                        "font": {
                        "type": "object"

                        },
                        "button": {
                          "type": "object"
                        },
                        "header": {
                          "type": "object"
                        },
                        "content_area": {
                          "type": "object"
                        },
                        "footer": {
                          "type": "object"
                        },
                        "paddle": {
                          "type": "object"
                        },
                      }
                    }
                  }
                }
              },
           "responses": {
                "204": {
                  "description": "Update Successful",
