    "/{auction_id}": {

        "patch": {
          "tags": ["Auction"],
          "summary": "Auction update",
          "description": "Allows editing auction details. Certain fields are restricted once the auction is published.",
          "parameters": [
                {
                  "name": "auction_id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  },
                  "example": "A0001"
                }
              ],
          "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string"
                        },
                        "faq": {
                          "type": "array",
                          "items": {
                            "type": "object",
