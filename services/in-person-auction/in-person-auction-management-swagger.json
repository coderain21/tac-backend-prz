{
  "openapi": "3.0.0",
  "info": {
    "title": "In Person Auction Management APIs",
    "description": "Auction APIs to create the API's",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis.dev.indyauction.net/v1/in-person-auctions"
    }
  ],
  "tags": [
    {
      "name": "Auction Management",
      "description": "APIs to manage the auctions list"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "tags": ["Auction"],
        "summary": "Auction create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Auction"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "message": "Auction created successfully",
                  "auctions_id": "A0362"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "message": "Something went wrong. Please try again!"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "message": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Auction": {
        "type": "object",
        "properties": {
          "seller_email": {
            "type": "string"
          },
          "auction_id": {
            "type": "string"
          },
          "template_name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "menu_links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "link_url": {
                  "type": "string"
                },
                "dropdown": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "link_url": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "auction_type": {
            "type": "string"
          },
          "accept_absentee_bid": {
            "type": "boolean"
          },
          "accept_telephone_bid": {
            "type": "boolean"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "logo_image": {
            "type": "string"
          },
          "logo_redirection_url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "auction_image": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "start_date": {
            "type": "number"
          },
          "registration_type": {
            "type": "string"
          },
          "add_buyer_fees": {
            "type": "number"
          },
          "time_zone": {
            "type": "string"
          },
          "faq": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "answer": {
                  "type": "string"
                }
              }
            }
          },
          "terms_and_condition": {
            "type": "string"
          },
          "publish_auction_result": {
            "type": "boolean"
          },
          "toggle_powered_by_indy": {
            "type": "boolean"
          },
          "hide_auction_lots": {
            "type": "boolean"
          },
          "make_your_auction_private": {
            "type": "boolean"
          },
          "passcode": {
            "type": "string"
          },
          "font": {
            "type": "object"
          },
          "button": {
            "type": "object"
          },
          "header": {
            "type": "object"
          },
          "content_area": {
            "type": "object"
          },
          "footer": {
            "type": "object"
          },
          "paddle": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Bearer Token"
      }
    }
  }
}
