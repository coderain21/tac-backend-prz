                          "type": "string"
                        },
                        "auction_image": {
                          "type": "string"
                        },
                        "add_buyer_fees": {
                          "type": "number"
                        },
                        "time_zone": {
                          "type": "string"
                        },
                        "toggle_powered_by_indy": {
                          "type": "boolean"
                        },
                        "hide_auction_lots": {
                          "type": "boolean"
                        },
                        "make_your_auction_private": {
                          "type": "boolean"
                        },
                        "accept_absentee_bid": {
                          "type": "boolean"
                        },
                        "accept_telephone_bid": {
