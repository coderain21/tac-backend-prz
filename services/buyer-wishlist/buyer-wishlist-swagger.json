          "description": "Buyer id of a buyer",
          "schema": {
            "type": "string"
          },
          "example": "65c9f5123226f499622c5cd4"
        },
        {
          "name": "seller_email",
          "in": "query",
          "description": "seller email",
          "schema": {
            "type": "string"
          },
          "example": "sthuthi+stripe@7edge.com"
        },
        {
          "name": "auction_id",
