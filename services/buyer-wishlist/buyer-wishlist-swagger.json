{
  "openapi": "3.0.0",
  "info": {
    "title": "Buyers Wishlist Management APIs",
    "description": "APIs to add and remove lots from the buyer wishlist side of the auction",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis-dev.indyauction.net/v1/buyer-wishlist"
    }
  ],
  "tags": [
    {
      "name": "Buyers Wishlist Management",
      "description": "APIs to manage the wishlist"
    }
  ],
  
  "paths": {
    "/": {
      "post": {
        "tags": ["Wishlist"],
        "summary": "Add to wishlist",
        "description": "Add to wishlist",
        "parameters": [
          {
            "name": "lot_id",
            "in": "query",
            "description": "lot id of a lot",
            "schema": {
              "type": "string"
            },
            "example": "654d13dbbbb8401327bc1196"
          },
          {
            "name": "auction_uid",
            "in": "query",
            "description": "auction uid",
            "schema": {
              "type": "string"
            },
            "example": "65c2294ed2c31913959127d6"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "auction_name": {
                    "type": "string"
                  },
                  "auction_uid": {
                    "type": "string"
                  }
                }
              },
              "example":{
                "auction_name": "test",
                "auction_uid": "65c2294ed2c31913959127d6"
              }
            }
          }
        },                 
        "responses": {
          "200": {
            "description": "Lot added to wishlist successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Lot added to wishlist successfully"
                    }
                }
              }
            }
          }
        },
          "400": {
            "description": "Existing lot for a user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Lot already exist in wishlist"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "message": "Auction with associated auction_id doesn't exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "There was an error "
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
 
  "/remove": {
    "delete": {
      "tags": ["Wishlist"],
      "summary": "remove from wishlist",
      "description": "remove from wishlist",
      "parameters": [
        {
          "name": "lot_id",
          "in": "query",
          "description": "lot id of a lot",
          "schema": {
            "type": "string"
          },
          "example": "654d13dbbbb8401327bc1196"
        }
      ],                
      "responses": {
        "200": {
          "description": "Lot removed from wishlist successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Lot removed from wishlist"
                  }
              }
            }
          }
        }
      },
        "400": {
          "description": "lot id not found in wishlist",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "Lot not found in wishlist"
                  }
                }
              }
            }
          }
        },
        "404": {
          "description": "Not found",
          "content": {
            "application/json": {
              "examples": {
                "example1": {
                  "value": {
                    "message": "Auction with associated auction_id doesn't exists"
                  }
                }
              }
            }
          }
        },
        "500": {
          "description": "Internal Server Error",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "There was an error "
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/wishlist": {
