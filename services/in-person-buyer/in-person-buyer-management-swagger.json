{
  "openapi": "3.0.0",
  "info": {
    "title": "In Person Buyer Management APIs",
    "description": "In Person Buyer APIs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis.dev.indyauction.net/v1/in-person-buyer"
    }
  ],
  "tags": [
    {
      "name": "In Person Buyer Management",
      "description": "APIs to manage the buyer"
    }
  ],
  "paths": {
    "/list-lots": {
      "get": {
        "tags": ["In person Lot Management"],
        "summary": "view in person lots",
        "description": "view in person lots",
        "parameters": [
          {
            "name": "auction_id",
            "in": "query",
            "description": "to determine the which auction lots to be displayed ",
            "schema": {
              "type": "string"
            },
            "example": "651e448f536806fbf8037c3c"
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort by key",
            "schema": {
              "type": "string"
            },
            "example": "highest_price"
          },
          {
            "name": "page",
            "in": "query",
            "description": "page number",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "number of records per page",
            "schema": {
              "type": "string"
            },
            "example": "10"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved lots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "schema": {
                            "$ref": "#/components/schemas/Lots"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "_id": "689b2e1afdfbdeb6a450f491",
                      "title1": "lot 1",
                      "title2": "",
                      "description": "<p>Lot description</p>",
                      "low_estimate": 0,
                      "high_estimate": 0,
                      "shipping_details": "",
                      "tags": [],
                      "auction_id": "A2099",
                      "current_bid": 0,
                      "images": [
                        {
                          "url": "DomainName/Auctions/lots/images/c89565f4-db30-f0c5-0c7a-b7baed15a8a1/sbsract2.webp",
                          "featured": true
                        }
                      ],
                      "lot_number": 1,
                      "__v": 0
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "example": "Please provide auction_id"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "example": "You do not have access to perform this API action"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Lots": {
        "type": "object",
        "properties": {
          "auction_id": {
            "type": "string"
          },
          "seller_email": {
            "type": "string"
          },
          "lot_number": {
            "type": "integer"
          },
          "lot_title": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "feature": {
                  "type": "boolean"
                }
              }
            }
          },
          "title1": {
            "type": "string"
          },
          "title2": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "low_estimate": {
            "type": "integer"
          },
          "high_estimate": {
            "type": "integer"
          },
          "shipping_details": {
            "type": "string"
          },
          "start_date": {
            "type": "number"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Bearer Token"
      }
    }
  }
}

