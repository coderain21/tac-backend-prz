                  },
                  "content_area": {
                    "background_color": "#FFFFFF",
                    "text_color": "#555555"
                  },
                  "footer": {
                    "background_color": "#333333",
                    "text_color": "#FFFFFF"
                  },
                  "paddle": {
                    "background_color": "#FFD700",
                    "text_color": "#333333"
                  },
                  "status": "Active"
                }
              
            }
          }
        },
          "responses": {
            "201":{
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "Internal server error"
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Bad Request",
