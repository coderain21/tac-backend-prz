                    },
                    {
                      "add_question": "What payment methods are accepted?",
                      "add_answer": "We accept credit cards and PayPal."
                    }
                  ],
                  "time_zone": "UTC+5:30",
                  "terms_and_condition": "By participating, you agree to our terms.",
                  "publish_auction_results": true,
                  "show_bidder_location_in_bidder_history": true,
                  "make_your_auction_private": true,
                  "passcode": "1234",
                  "font": {
                    "hearder_font": "Arial",
                    "body_font": "Helvetica"
                  },
                  "buttons": {
                    "background_color": "#007BFF",
                    "text_color": "#FFFFFF"
