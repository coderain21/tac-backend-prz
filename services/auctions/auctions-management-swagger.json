{
    "openapi": "3.0.0",
    "info": {
      "title": "Auction Management APIs",
      "description": "Auction APIs to create the API's",
      "contact": {
        "name": "no-reply@indy.auction",
        "email": "no-reply@indy.auction"
      },
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "https://apis.indyauction.net/dev/v1/auctions"
      }
    ],
    "tags": [
      {
          "name": "Auction Management",
          "description": "APIs to manage the auctions list"
      }
    ],
    "paths": {
      "/":{
        "post": {
          "tags": [
            "create"
          ],
          "summary": "Auction create",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Auction"
              },
              "example": {
                "template_name": "Auction Template 1",
                "extension_time_between_lots": "2m",
                "menu_links": [
                  {
                    "title": "Home",
                    "link_url": "https://example.com/home",
                    "dropdown": [
                      {
                        "title": "About Us",
                        "link_url": "https://example.com/about"
                      },
                      {
                        "title": "Contact Us",
                        "link_url": "https://example.com/contact"
                      }
                    ]
                  }
                ],
                "logo_image": "https://example.com/logo.png",
                "logo_redirection_url": "https://example.com",
                "title": "Auction Event",
                  "auction_image": "https://example.com/auction-image.png",
                  "description": "Join our exciting auction event!",
                  "currency": "USD",
                  "start_date": 1669966800,
                  "end_date": 1669966800,
                "note": "asda",
                "extension_type": "Automatic",
                "extension_time": "5 minutes",
                "registration_type": "Open",
                "add_buyer_fees": "10%",
                "faq": [
                  {
                    "question": "How do I participate?",
                    "answer": "Register on our website and place bids."
                  },
                  {
                    "question": "What payment methods are accepted?",
                    "answer": "We accept credit cards and PayPal."
                  }
                ],
                "time_zone": "UTC+5:30",
                "terms_and_condition": "By participating, you agree to our terms.",
                "publish_auction_results": true,
                "show_bidder_location_in_bidder_history": true, 
                "make_your_auction_private": true,
                "passcode": "1234",
                "font": {
                  "hearder_font": "Arial",
                  "body_font": "Helvetica"
                },
                "buttons": {
                  "background_color": "#007BFF",
                  "text_color": "#FFFFFF"
                },
                "header": {
                  "background_color": "#F2F2F2",
                  "text_color": "#333333"
                },
                "content_area": {
                  "background_color": "#FFFFFF",
                  "text_color": "#555555"
                },
                "footer": {
                  "background_color": "#333333",
                  "text_color": "#FFFFFF"
                },
                "paddle": {
                  "background_color": "#FFD700",
                  "text_color": "#333333"
                },
                "status": "Active"
              }
              
            }
          }
        },
          "responses": {
            "201":{
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "Internal server error"
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Bad Request",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "Validation failed"
                      }
                    },
                    
                    "example4":{
                      "value":{
                        "message":"Invalid request"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "get": {
          "tags": [
            "create"
          ],
          "summary": "Listing auction",
          "description": "Listing auction",
          "parameters": [
            {
              "name": "start_date",
              "in": "query",
              "description": "Filter by date range, this is the start date",
              "schema": {
                "type": "string",
                "format": "date"
              },
              "example": "2023-07-30"
            },
            {
              "name": "end_date",
              "in": "query",
              "description": "Filter by date range, this is the end date",
              "schema": {
                "type": "string",
                "format": "date"
              },
              "example": "2023-08-31"
            },
            {
              "name": "status",
              "in": "query",
              "description": "Filter by status",
              "schema": {
                "type": "string"
              },
              "example": "Draft"
            },
            {
              "name": "sort",
              "in": "query",
              "description": "If sort is opted",
              "schema": {
                "type": "string"
              },
              "example": "true"
            },
            {
              "name": "key",
              "in": "query",
              "description": "Sort by key",
              "schema": {
                "type": "string"
              },
              "example": "title"
            },
            {
              "name": "order",
              "in": "query",
              "description": "ascending or descending",
              "schema": {
                "type": "string"
              },
              "example": "ascending"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Filter by status",
              "schema": {
                "type": "integer"
              },
              "example": 1
            },
            {
              "name": "keyword",
              "in": "query",
              "description": "ascending or descending",
              "schema": {
                "type": "string"
              },
              "example": "C"
            }

          ],
          "responses": {
            "200": {
              "description": "Successfully retrieved auctions",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Auction"
                  },
                  "example": {
                          "message": "Query successful",
                          "results": [
                            {
                              "auction_id": "A0001",
                              "title": "Reserve Price Auction",
                              "start_date": "2023-08-30 06:46:23",
                              "end_date": "2023-08-31 06:46:23",
                              "status": "Draft",
                              "created_at": "2023-08-31 10:27:57.993000"
                            }
                          ],
                          "total_records_found": 1,
                          "current_page": 1,
                          "total_pages": 1
                        }
                  
                }
              }
            },
            "400": {
              "description": "forbidden",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": {
                          "type": "string",
                          "example": "You do not have access to perform this API action"
                        }
                      }
                    }    
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Internal server error"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "patch": {
          "tags": [
            "create"
          ],
          "summary": "delete auction",
          "description": "delete auction",
          "parameters": [
            {
              "name": "auction_id",
              "in": "query",
              "description": "to delete or add note for that auction id",
              "schema": {
                "type": "string"
              },
              "example": "A0001"
            },
            {
              "name": "del",
              "in": "query",
              "description": "keyword to determine whether to add or delete",
              "schema": {
                "type": "string"
              },
              "example": "1"
            }

          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "note":{
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "note":"asda"

                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Successfully deleted the note or added the note",
              "content": {
                "application/json": {
                  "example": {
                          "message": "string"   
                  }            
                }
              }
            },
            "400": {
              "description": "forbidden",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": {
                          "type": "string",
                          "example": "You do not have access to perform this API action"
                        }
                      }
                    }    
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Internal server error"
                      }
                    }
                  }
                }
              }
            }
          }
        }
        
      }

    },
    "components": {
