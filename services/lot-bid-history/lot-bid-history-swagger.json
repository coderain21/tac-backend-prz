{
    "openapi": "3.0.0",
    "info": {
      "title": "Seller Lot Bid History APIs",
      "description": "Seller Lot Bid History APIs to view list of the bidders who has placed the bid",
      "contact": {
        "name": "no-reply@dev.indyauction.net",
        "email": "no-reply@dev.indyauction.net"
      },
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "https://apis.dev.indyauction.net/v1/lot-bid-history"
      }
    ],
    "tags": [
      {
          "name": "Bid History Management",
          "description": "APIs to view list of the bidders who has placed the bid"
      }
    ],
    "paths": {
      "/{lot_id}": {
        "get": {
          "summary": "List Bids",
          "description": "Fetch a list of bidders for an lot.",
          "tags": [
            "Bid History  Management"
          ],
          "parameters": [
            {
              "name": "lot_id",
              "in": "path",
              "required": true,
              "example": "682acbe62ddaf4fca7223db9",
              "description": "The unique identifier of the lot.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "sort_by",
              "in": "query",
              "description": "Sort field (e.g., paddle_number, name, bid_amount, time_stamp)",
              "schema": {
                "type": "string"
              },
              "example": "name"
            },
            {
              "name": "sort_order",
              "in": "query",
              "description": "Sort order (e.g., asc, desc)",
              "schema": {
                "type": "string"
              },
              "example": "asc"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Page number for pagination",
              "schema": {
                "type": "integer"
              },
              "example":"1"
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Number of items per page",
              "schema": {
                "type": "integer"
              },
              "example": "10"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful response with a list of bids.",
              "content": {
                "application/json": {
                  "example": {
                    "data": [
                      {
                        "_id": "65a6bad418d9a00370823dd5",
                        "paddle_number": "1",
                        "bid_amount": 100,
                        "name": "Sthuthi",
                        "created_at": "2024-01-16T17:20:20.207Z",
                        "updated_at": "2024-01-16T17:20:20.207Z",
                        "is_greyed_out": true
                      }
                    ],
                    "pagination": {
                      "total_pages": 31,
                      "limit": 1,
                      "total_records": 31,
                      "next_page": 2,
                      "page": 1
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Bids History Not found.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/admin/bid/{bid_id}": {
        "delete": {
          "summary": "Delete Bid",
          "description": "Delete a bid from the system. This will remove the bid from the history and update the top bidder accordingly.",
          "tags": [
            "Bid History Management"
          ],
          "parameters": [
            {
              "name": "bid_id",
              "in": "path",
              "required": true,
              "example": "682acbe62ddaf4fca7223db9",
              "description": "The unique identifier of the bid to be deleted.",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Bid successfully deleted",
              "content": {
                "application/json": {
                  "example": {
                    "message": "Bid successfully deleted",
                    "deleted_bid_id": "682acbe62ddaf4fca7223db9",
                    "new_top_bidder": "John Doe"
                  }
                }
              }
            },
            "400": {
              "description": "Bad request, such as trying to delete a bid on a closed auction",
              "content": {
                "application/json": {
                  "example": {
                    "message": "Cannot delete bid on a closed or locked auction"
                  }
                }
              }
            },
            "404": {
              "description": "Bid not found",
              "content": {
                "application/json": {
                  "example": {
                    "message": "Bid not found"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error.",
              "content": {
                "application/json": {
                  "example": {
                    "message": "There was an error while deleting the bid"
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/seller/bids": {
        "get": {
          "summary": "List Bids",
          "description": "Fetch a list of bids placed on a particular auction.",
          "tags": [
            "Bid History  Management"
          ],
          "parameters": [
            {
              "name": "auction_id",
              "in": "query",
              "required": true,
              "example": "A0010",
              "description": "Auction id",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "sort_by",
              "in": "query",
              "description": "Sort field",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "sort_order",
              "in": "query",
              "description": "Sort order (e.g., asc, desc)",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "page",
              "in": "query",
              "description": "Page number for pagination",
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "limit",
              "in": "query",
              "description": "Number of items per page",
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful response with a list of bids.",
              "content": {
                "application/json": {
                  "example": {
                    "data": [],
                    "total_records_found": 0,
                    "total_lots": 0,
                    "current_page": 1,
                    "total_pages": 0,
                    "number_of_bids": 1,
                    "sum_current_bid": 0,
                    "total selling": 0
                }
                }
              }
            },
            "500": {
              "description": "Internal server error.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Buyers list Not found.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      }
    },
    "components": {
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "description": "Bearer Token"
        }
      }
    }
  }
