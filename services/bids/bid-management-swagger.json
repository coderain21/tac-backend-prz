              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                          "example": "You do not have access to perform this API action"
                        
                      }
                    }    
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "There was an error an while retrieving the bidders list."
                      }
                    }
                  }
                }
              }
