{
    "openapi": "3.0.0",
    "info": {
      "title": "Bidding Management APIs",
      "description": "",
      "version": "1.0.0"
    },
    "servers": [
      {
        "url": "https://apis.dev.indyauction.net/v1/bids"
      }
    ],
    
    "tags": [
      {
          "name": "Bidders Management",
          "description": "APIs to manage the Bidders"
      }
    ],
    "paths": {
      "/":{
        "get": {
          "tags": [
            "Bidders Management"
          ],
          "summary": "Listing bidders",
          "description": "Listing bidders",
          "parameters": [
            {
              "name": "key",
              "in": "query",
              "description": "Sort by key",
              "schema": {
                "type": "string"
              },
              "example": "status"
            },
            {
              "name": "order",
              "in": "query",
              "description": "ascending or descending",
              "schema": {
                "type": "string"
              },
              "example": "ascending"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Page number",
              "schema": {
                "type": "integer"
              },
              "example": 1
            },
            {
              "name": "keyword",
              "in": "query",
              "description": "ascending or descending",
              "schema": {
                "type": "string"
              },
              "example": "C"
            },
            {
              "name": "auction_id",
              "in": "query",
              "description": "related auction id",
              "schema": {
                "type": "string"
              },
              "example": "6540bd891bb1fa2adeb445f2"
            }
  
          ],
          "responses": {
            "200": {
              "description": "Successfully retrieved bidders list",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": { 
                      "data": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "_id": {
                              "type": "string"
                            },
                            "first_name": {
                              "type": "string"
                            },
                            "last_name": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "auction_id": {
                              "type": "string"
                            },
                            "email_address": {
                              "type": "string"
                            },
                            "status": {
                              "type": "string"
                            },
                            "created_at": {
                              "type": "string"
                            },
                            "paddle": {
                                "type": "integer"
                              }
                          }
                        }
                      },
                      "total_records_found": {
                        "type": "integer"
                      },
                      "total_bidders": {
                        "type": "integer"
                      },
                      "current_page": {
                        "type": "integer"
                      },
                      "total_pages": {
                        "type": "integer"
                      }
                    }
                  },
                  "example": {
                          "data": [
                            {
                                "_id": "653b4274d3c3ab4f70f53b86",
                                "first_name": "Anusha",
                                "auction_id": "6528c45d51fda586c37079e4",
                                "email_address": "anusha.k+op820@7edge.com",
                                "status": "Pending",
                                "paddle": 1,
                                "created_at": "2023-10-27 04:54:12.682000"
                            }
                          ],
                          "total_records_found": 1,
                          "total_bidders": 1,
                          "current_page": 1,
                          "total_pages": 1
                        }
                  
                }
              }
            },
            "403": {
              "description": "forbidden",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                          "example": "You do not have access to perform this API action"
                        
                      }
                    }    
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "There was an error an while retrieving the bidders list."
                      }
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/update": {
        "patch": {
          "tags": ["Bidders Management"],
          "summary": "Update Bidders data after social signup",
          "description": "Update Bidders data after social signup",
          "parameters": [
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "group": {
                      "type": "string"
                    },
                    "auction_id":{
                      "type": "string"
                    }
                }
              },
              "example": {
                "group": "aishwarya+401",
                "auction_id": "654cdc658f15384efe13b200"
              }
            }
          }
          },
          "responses": {
            "204": {
              "description": "Bidder data updated"
            },
            "400": {
              "description": "Bad Request",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "Please provide auction_id"
                      }
                    }
                  }
                }
              }
            },
            "403": {
              "description": "forbidden",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "You do not have access to perform this API action"
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Not found",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "User does not exist"
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "There was an error while adding to the group "
                      }
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
