{
  "openapi": "3.0.0",
  "info": {
    "title": "Quicksight Dashboard APIs",
    "description": "APIs for the seller to manage.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://apis.dev.indyauction.net/v1/quicksight-dashboards"
    }
  ],
  "tags": [
    {
      "name": "Quicksight Dashboard",
      "description": "APIs to manage the quicksight in the seller side application"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "View the dashboard from quicksight",
        "description": "Fetch dashboard from quicksight",
        "tags": [
          "Quicksight Dashboard"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with an embedded url for the dashboard",
            "content": {
              "application/json": {
                "example": {
                  "embed_url": "https://eu-west-2.quicksight.aws.amazon.com/embed/9db14d1ee70e4a169e3233bb80744c13/dashboards/25c91904-12bc-4233-81aa-7b31698622d2?code=AY"
              }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Dashboard not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}