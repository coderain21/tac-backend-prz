    "paths": {
       "/{email}": {
        "get": {
          "tags": [
            "Users"
          ],
          "summary": "View user information",
          "parameters": [
            {
              "required": true,
              "name": "email",
              "in": "path",
              "description": "get user by email",
              "schema": {
                "type": "string"
              },
              "example": "aishwarya@7edge.com"
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "first_name": {
                          "type": "string"
                        },
                        "last_name": {
                          "type": "string"
                        },
                        "brand_name": {
                          "type": "number"
                        },
                        "email_address": {
                          "type": "string"
                        },
                        "business_registration_number": {
                          "type": "string"
                        },
                        "website": {
                          "type": "string"
                        },
                        "address_line_1": {
                          "type": "string"
                        },
                        "address_line_2": {
                          "type": "string"
                        },
                        "city": {
                          "type": "string"
                        },
                        "postal_code": {
                          "type": "string"
                        },
                        "country": {
                          "type": "string"
                        },
                        "phone_number": {
                          "type": "string"
                        },
                        "date_of_birth": {
                          "type": "string"
                        },
                        "about": {
                          "type": "string"
                        },
                        "facebook_link": {
                          "type": "string"
                        },
                        "Instagram_link": {
                          "type": "string"
                        },
                        "twitter": {
                          "type": "string"
                        },
                        "linkedin_link": {
                          "type": "string"
                        },
                        "tiktok_link": {
                          "type": "string"
                        },
                        "kyc_status": {
                          "type": "boolean"
                        },
                        "kyb_status": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "403": {
              "description": "Forbidden",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "404": {
                "description": "view user",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
          }
        },
        "patch":{
          "tags": [
            "Customers"
          ],
          "summary": "Update user information",
          "parameters": [
            {
              "name": "email",
              "in": "path",
              "description": "Update user information",
              "required": true,
              "schema": {
                "type": "string"
              },
              "example": "aishwarya@7edge.com"
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "first_name":{
