                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "You do not have access to perform this API action"
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error - There was an error while generating token",
