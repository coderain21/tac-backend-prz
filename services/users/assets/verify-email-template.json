        "HtmlPart": "<!DOCTYPE html> <html lang='en' style='font-family: 'Sora', sans-serif; background: #f1f1f1; margin: 0 auto; padding: 0; height: 100%; width: 100%;'> <head> <title>Email Template - New Admin User</title> <meta charset='utf-8'> <meta name='viewport' content='width=device-width'> <link rel='preconnect' href='https://fonts.googleapis.com'> <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin=''> <link href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap' rel='stylesheet'> </head> <style> @media (max-width:768px) {  .heading-section { width: 500px;  }  .content { padding: 45px 20px 30px;  }  .heading-section .content div { padding: 13px 0px;  }  .heading-section .content .footer-links { padding: 0;  }  a { font-size: 14px;  } } @media (max-width:575px) {  .heading-section p.heading-name { font-size: 14px; line-height: 16px;  }  .heading-section p { font-size: 14px; line-height: 16px;  }  .heading-section { margin: 0 20px;  }  .heading-section .content div { padding: 13px 0px;  }  .heading-section .footer-links p { font-size: 12px; line-height: 16px;  }  .heading-section .content .footer-links { padding: 0;  }  a { font-size: 14px;  } } </style>  <body style='font-family: 'Sora', sans-serif; background: #f1f1f1; margin: 0 auto; height: 100%; width: 100%; padding: 0;'> <div style='background-color: #FCFBFA;min-width: 100% !important; height: 100%;' class='email-container'> <table aria-label='Outside Table' style='background-color: #FFFFFF; height: 100%; border-spacing: 0; border-collapse: collapse; table-layout: fixed; margin: 0 auto; min-width: 100%;' height='100%' bgcolor='#FFFFFF'> <tbody> <tr> <th scope='col'></th> <td>  <div class='heading-section' style='width: 765px; margin: 80px auto;'>  <img src='https://easidesi-assets-dev.s3.me-south-1.amazonaws.com/images/easidesi-logo.png' alt='icon' style='width: 100%;'>  <div class='content' style='padding: 50px 110px 20px;'>  <div style='padding: 15px 0px;'>  <p class='heading-name' style='font-size: 15px; font-weight: 400; color: #673593; line-height: 24px; margin: 0;'>Hi {{customer_name}},</p>  </div>  <div style='padding: 15px 0px;'>  <p style='font-size: 15px; line-height: 24px; font-weight: 300; color: #000000; margin: 0;'>Verify your email address using the link below.</p>  </div>  <div style='padding: 15px 0px;'>  <a href='{{verification_link}}' style='color: #041AC1; font-size: 15px; font-weight: 300; text-decoration: none;'>{{verification_link}}</a>  </div>  <div style='padding: 15px 0px;'>  <p style='font-size: 15px; line-height: 24px; font-weight: 300; color: #000000; margin: 0;'>Valid for 10 mins only.</p>  </div>  <div style='padding: 15px 0px;'>  <p style='font-size: 15px; line-height: 24px; font-weight: 300; color: #000000; margin: 0;'>If you didn’t request for your email address to be verified, please reach out to 'easidesi Help Desk'</p>  </div>  <div style='padding: 15px 0px;'>  <p style='font-size: 15px; line-height: 24px; font-weight: 300; color: #000000; margin: 0;'>See you there!</p>  <p class='heading-name' style='font-size: 15px; font-weight: 400; color: #673593; line-height: 24px; margin: 0;'>Team easidesi</p>  </div>  <hr class='custom-hr'>  <div class='footer-links' style='padding: 0;'>  <p style='font-size: 14px; line-height: 19px; color: #767B81; font-weight: 400; text-align: center; margin: 0;'>Please do not reply to this auto-generated email</p>  </div>  </div>  </div> </td> </tr> </tbody> </table> </div> </body> </html> "
