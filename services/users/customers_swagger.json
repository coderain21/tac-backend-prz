      "/scan": {
        "post": {
          "tags": [
            "Customers"
          ],
          "summary": "Scan the QR Code",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example":{
                 "activation_code": "FRE0000000000005",
                 "email": "anusha.k+test1@7edge.com"
              }
              }
            }
          },
          "responses": {
            "200": {
              "description": "successfully scanned",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "language": {
                        "type": "string"
                      }
                    },
                    "example":{
                      "message": "QR Code scanned successfully",
                      "language": "French"
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Invalid request payload",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example":{
                      "message": "Please pass QR code ID"
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Unauthorized",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example":{
                      "message":"Code is invalid, give it another try"
                    }
                  }
                }
              }
            },
            "403": {
              "description": "Forbidden",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "404": {
              "description": "QR Code Not Found",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example": {
                      "message": "QR Code not found"
                    }
                  }
                }
              }
            },
            "409": {
              "description": "QR Code already registered",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example": {
                      "message": "Code is already registered try with another one"
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
