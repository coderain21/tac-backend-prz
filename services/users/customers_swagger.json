      "/send_otp/{email}": {
        "get": {
          "tags": [
            "Customers"
          ],
          "summary": "User send password reset OTP",
          "parameters": [
            {
              "required": true,
              "name": "email",
              "in": "path",
              "description": "request password by providing email",
              "schema": {
                "type": "string"
              },
              "example": "anusha.k+admin1@7edge.com"
            }
          ],
          "responses": {
            "200": {
              "description": "OTP has been sent successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "session":{
                        "type": "string"
                      }
                    },
                    "example": {
                      "message": "OTP sent successfully",
                      "session":"asdacascacdvdsvdvadsvada"
                    }
                  }
                }
              }
            },
            "403": {
              "description": "Forbidden",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "404": {
                "description": "User not found",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "example": {
                        "message": "User Not Found"
                      }
                    }
                  }
                }
              },
            "500": {
            "description": "Internal Server Error",
            "content": {
                "application/json": {
                "schema": {
                    "type": "object",
                    "properties": {
                    "message": {
                        "type": "string"
                    }
                    },
                    "example": {
                    "message": "There was an error sending OTP"
                    }
                }
                }
            }
            }
          }
        }
      },
      "/verify_otp": {
        "post": {

          "tags": [
            "Customers"
          ],
          "summary": "Verify User OTP",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "otp": {
                      "type": "integer"
                    },
                    "session": {
                      "type": "string"
                    }
                  },
                  "required": ["otp", "session"]
                },
                "example": {
                  "otp": 567890,
                  "session": "adakjdajdnajbdkabdkandadnsacasbckajcnkacajbcjsabck"
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ],
          "responses": {
            "204": {
              "description": "No Content"
            },
            "400": {
              "description": "Invalid request payload",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  },
                  "examples": {
                    "example1": {
                      "value": {
                        "message": "Please pass valid OTP"
                      }
                    },
                    "example2": {
                      "value": {
                        "message": "Missing mandatory fields"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Unauthorized",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example":{
                        "message": "You are not authorized to perform this API action"
                      }
                  }
                }
              }
            },
            "403": {
              "description": "Forbidden",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "example":{
                        "message": "There was an error while verifying OTP"
                      }
                  }
                }
              }
            }
          }
        }
      },
      "/update_password/{email}":{
        
