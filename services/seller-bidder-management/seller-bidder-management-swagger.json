    "servers": [
      {
        "url": "https://apis.dev.indyauction.net/v1/seller-bidder-management"
      }
    ],
    "tags": [
      {
          "name": "Seller | List Bidders",
          "description": "APIs to view list of the bidders"
      }
    ],
    "paths": {
      "/":{
        "get": {
          "tags": [
            "Seller| Bidder Management"
            
          ],
          "summary": "Listing Bidders",
          "description": "Listing Bidders",
          "parameters": [
            {
              "name": "sort_key",
              "in": "query",
              "description": "Sort by key",
              "schema": {
                "type": "string"
              },
              "example": "email_address"
            },
            {
              "name": "sort_order",
              "in": "query",
              "description": "ascending or descending",
              "schema": {
                "type": "string"
              },
              "example": "ascending"
            },
            {
              "name": "page_number",
              "in": "query",
              "description": " page number",
              "schema": {
                "type": "integer"
              },
              "example": 1
            },
            {
              "name": "search",
              "in": "query",
              "description": "search key",
              "schema": {
                "type": "string"
              },
              "example": "C"
            }
  
          ],
          "responses": {
            "200": {
              "description": "Successfully retrieved buyers",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": { 
                      "buyers": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "_id": {
                              "type": "string"
                            },
                            "email_address": {
                              "type": "number"
                            },
                            "marketing": {
                              "type": "boolean"
                            },
                            "name": {
                              "type": "string"
                            },
                            "created_at": {
                              "type": "string"
                            },
                            "time_zone": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "total_buyers": {
                        "type": "integer"
                      },
                      "page_number": {
                        "type": "integer"
                      },
                      "page_size": {
                        "type": "integer"
                      }
                    }
                  },
                  "example": {
                    "buyers": [
                      {
                        "_id": "6540c17d9cc11ec0bf466b84",
                        "auction_id": "6540c0beca765df3f80d2275",
                        "email_address": "anusha.k+buyer0@7edge.com",
                        "created_at": "2023-10-31 08:57:33.279000",
                        "marketing": false,
                        "time_zone": "BST - British Summer Time"
                      },
                      {
                        "_id": "662c8892a5579605ea2a4c81",
                        "name": "Sthuthi ",
                        "auction_id": "65faa94a10547dace8fe1c2b",
                        "email_address": "sthuthi+test@7edge.com",
                        "created_at": "2024-04-25 12:34:55.949000",
                        "marketing": false,
                        "time_zone": "UTC+5:30"
                      }
                    ],
                    "total_buyers": 2,
                    "page_size": 10,
                    "page_number": 1,
                    "time_zone": "UTC+5:30",
                    "csv_url": ""
                  }
                }
              }
            },
            "403": {
              "description": "forbidden",
              "content": {
                "application/json": {
                  "examples": {
                    "example1": {
                      "value": {
                          "example": "You do not have access to perform this API action"
                        
                      }
                    }    
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Internal server error"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/seller-orders": {
      "get": {
        "tags": [
          "Seller | Orders"
        ],
        "summary": "Seller's order Details",
        "description": "Seller's order details",
        "parameters": [
          {
            "name": "buyer_id",
            "in": "path",
            "description": "buyer id",
            "schema": {
              "type": "string"
            },
            "example": "659393fff55ff30b3ff4221b"
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "sorting by key",
            "schema": {
              "type": "string"
            },
            "example": "name"
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "sorting by descending or ascending order",
            "schema": {
              "type": "string"
            },
            "example": "descending"
          },
          {
            "name": "page_number",
            "in": "query",
            "description": "page number",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "page size",
            "schema": {
              "type": "string"
            },
            "example": "3"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved buyer detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "data": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "_id": {
                          "type": "string"
                        },
                        "payment_status": {
                          "type": "string"
                        },
                        "payment": {
                          "type": "string"
                        },
                        "order_number": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "integer"
                        },
                        "auction_title": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "total_pages": {
                    "type": "integer"
                  },
                  "total_records": {
                    "type": "integer"
                  },
                  "current_page": {
                    "type": "integer"
                  }
                },
                "example": {
                  "data": [
                      {
                          "_id": "656d66fd3c32ca65775aca29",
                          "payment_status": "Paid",
                          "payment": "Stripe",
                          "order_number": "OD001",
                          "created_at": 1701668603,
                          "auction_title": "Demo auction (here)+",
                          "name": ""
                      }
                  ],
                  "total_pages": 1,
                  "total_records": 1,
                  "current_page": 1
              }
              }
            }
          },
          "403": {
            "description": "forbidden",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "example": "You do not have access to perform this API action"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Internal server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    },
    "components": {
