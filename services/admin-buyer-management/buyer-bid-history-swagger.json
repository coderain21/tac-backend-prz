      "/{buyer_id}": {
        "patch": {
          "tags": [
            "Admin | Update Buyer Registration Status"
          ],
          "summary": "Accept or Reject the buyers",
          "parameters": [
            {
              "required": true,
              "name": "buyer_id",
              "in": "path",
              "description": "Accept or Reject the buyers",
              "schema": {
                "type": "string"
              },
              "example": "659cf1def0d3374201bac434"
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status":{
                      "type": "string"
                    },
                    "auction_id": {
                      "type": "string"
                    },
                    "seller_email": {
                      "type": "string"
                    },
                    "email_address": {
                      "type": "string"
                    },
                    "first_name": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "seller_email": "sthuthi@7edge.com",
                  "auction_id": "659cf15edb87b8d624908f24",
                  "status": "Pending",
                  "email_address": "sandhyashri@7edge.com",
                  "first_name": "Sandy"
                }
              }
            }
          },
          "responses": {
            "204":{
              "description": "no content"
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "403": {
