  "components": {
    "schemas": {
      "GenerateQRCodesRequest": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "description": "note for QR code generation"
          },
          "language": {
            "type": "string",
            "description": "Language for the QR codes",
            "enum": [
              "French"
            ]
          },
          "quantity": {
            "type": "integer",
            "description": "Number of QR codes needed",
            "minimum": 1,
            "maximum": 1000
          },
          "uuid": {
            "type": "string",
            "description": "unique identifier"
          }
        },
        "required": [
          "quantity",
          "language",
          "uuid"
        ],
        "example": {
          "note": "Sample note",
          "language": "French",
          "quantity": 10,
          "uuid": "1234ruefffs"
        }
      },
      "viewQrCode": {
        "type": "object",
        "properties": {
          "success_status":{
            "type":"boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string"
              },
              "qr_code": {
                "type": "string"
              },
              "activation_code": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "created_on": {
                "type": "integer"
              },
              "customer_id": {
                "type": "string",
                "format": "date-time"
              },
              "qr_code_url": {
                "type": "string",
                "format": "date-time"
              },
              "quantity": {
                "type": "string",
                "format": "date-time"
              },
              "language": {
                "type": "string",
                "format": "date-time"
              }
            }
           
          }
         
        }
      },
      "users": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "child_first_name": {
            "type": "string"
          },
          "child_last_name": {
            "type": "string"
          },
          "child_age": {
            "type": "number"
          },
          "parent_first_name": {
            "type": "string"
          },
          "parent_last_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "country": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
      }
    }
  }
