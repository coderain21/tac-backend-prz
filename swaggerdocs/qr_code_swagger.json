  "paths": {
    "/qr-codes/generate-qr-codes": {
      "post": {
        "summary": "Generate QR Codes",
        "description": "Generate QR codes for product activation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateQRCodesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generating QR codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateQRCodesRequest"
                },
                "examples": {
                  "example1": {
                    "summary": "Example Response",
                    "value": {
                      "message": "QR codes generated successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "examples": {
                  "example1": {
                    "value": {
                      "success_status": false,
                      "message": "Please enter the value for language"

                    }
                  },
                  "example2": {
                    "value": {
                      "message": "Number should be between 1-1000",
                      "errors": {
                        "number": "should be between 1-1000"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "You are not authorized to perform this API action"
                    }
                  }
                },
                "example1": {
                  "summary": "Example Response",
                  "value": {
                    "message": "You are not authorized to perform this API action"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Failed to generate QR codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "There was an error Generating QR codes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qr-codes/view/{qr_code}": {
      "get": {
        "summary": "Get an qrcode by qr_code",
        "parameters": [
          {
            "name": "qr_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "000003"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/viewQrCode"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "example1": {
                    "summary": "Example Response",
                    "value": {
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
